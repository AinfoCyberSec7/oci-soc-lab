#!/bin/bash
# honeypot first boot: harden the REAL management plane first. The bait (Cowrie)
# is installed later as a separate, reviewed step; bait ports stay closed in the
# NSG until then. No secrets in this file (readable via instance metadata).
set -euxo pipefail
exec > /var/log/lab-bootstrap.log 2>&1
export DEBIAN_FRONTEND=noninteractive

ADMIN_PORT=${admin_port}
ADMIN_SRC=${admin_src}
LAB_CIDR=${lab_cidr}

retry() { for i in $(seq 1 20); do "$@" && return 0; echo "retry $i: $*"; sleep 15; done; return 1; }

# --- 1. Real sshd moves OFF port 22 (22/23 will belong to Cowrie) ---
cat > /etc/ssh/sshd_config.d/99-lab-hardening.conf <<EOF
Port $ADMIN_PORT
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
EOF
# --- Unused image account: Oracle's Ubuntu image creates "opc" (uid 1000) with the instance SSH key ---
if id opc >/dev/null 2>&1; then
  usermod -s /usr/sbin/nologin -e 1 opc
  passwd -l opc >/dev/null
  : > /home/opc/.ssh/authorized_keys 2>/dev/null || true
fi
printf '# opc comes with the Oracle Ubuntu image; it is not used in this lab.\nDenyUsers opc\n' > /etc/ssh/sshd_config.d/10-deny-opc.conf
# Ubuntu 24.04 uses socket activation; the generator reads Port on daemon-reload.
systemctl daemon-reload
systemctl restart ssh.socket || true
systemctl restart ssh || true

# --- 2. Host firewall (Oracle image ships iptables-persistent rules.v4) ---
# admin SSH only from core-arm
iptables -I INPUT 1 -s "$ADMIN_SRC" -p tcp -m state --state NEW -m tcp --dport "$ADMIN_PORT" -j ACCEPT
# the honeypot never opens NEW connections into the lab (replies still pass)
iptables -I OUTPUT 1 -d "$LAB_CIDR" -m state --state NEW -j REJECT
iptables-save > /etc/iptables/rules.v4

# --- 3. Unneeded listeners off ---
systemctl stop rpcbind.socket rpcbind.service || true
systemctl mask rpcbind.socket rpcbind.service

# --- 4. Swap (1 GB RAM) ---
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- 5. Packages ---
retry apt-get update
retry apt-get -y -o Dpkg::Options::="--force-confold" upgrade
retry apt-get install -y unattended-upgrades fail2ban docker.io rsync jq
echo 'APT::Periodic::Update-Package-Lists "1";'  >  /etc/apt/apt.conf.d/20auto-upgrades
echo 'APT::Periodic::Unattended-Upgrade "1";'    >> /etc/apt/apt.conf.d/20auto-upgrades

# fail2ban guards the REAL sshd only; the lab range is never banned (no self-lockout)
cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = $ADMIN_PORT
ignoreip = 127.0.0.1/8 ::1 $LAB_CIDR
EOF
systemctl enable --now fail2ban
systemctl restart fail2ban

# --- 6. Docker + container egress guard (containers may not reach the lab either) ---
systemctl enable --now docker
cat > /etc/systemd/system/docker-user-guard.service <<EOF
[Unit]
Description=Block containers from opening connections into the lab
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -d $LAB_CIDR -m state --state NEW -j REJECT 2>/dev/null || iptables -I DOCKER-USER 1 -d $LAB_CIDR -m state --state NEW -j REJECT'
[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now docker-user-guard.service

# --- 7. Data folder for Cowrie (owned by the image's cowrie user, uid 999) ---
install -d -o 999 -g 999 -m 0750 /srv/cowrie /srv/cowrie/var /srv/cowrie/etc

echo "BOOTSTRAP DONE" > /var/log/lab-bootstrap.done
chmod 644 /var/log/lab-bootstrap.done
