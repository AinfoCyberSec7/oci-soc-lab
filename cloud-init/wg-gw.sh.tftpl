#!/bin/bash
# wg-gw bootstrap: hardening + WireGuard gateway into the lab VCN.
# Rendered by Terraform templatefile(): bash variables are written as $${VAR}.
set -euxo pipefail
exec > /var/log/lab-bootstrap.log 2>&1
export DEBIAN_FRONTEND=noninteractive

# Retry helper: on first boot, Ubuntu's own apt timers can briefly hold the
# apt/dpkg locks. Without this, "set -e" would abort the whole bootstrap.
retry() { for i in $(seq 1 20); do "$@" && return 0; echo "retry $i: $*"; sleep 15; done; return 1; }

# --- 2 GB swap (the micro VM only has 1 GB RAM) ---
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- Packages + automatic security updates ---
retry apt-get update
retry apt-get -y -o Dpkg::Options::="--force-confold" upgrade
retry apt-get install -y wireguard unattended-upgrades fail2ban
echo 'APT::Periodic::Update-Package-Lists "1";'  >  /etc/apt/apt.conf.d/20auto-upgrades
echo 'APT::Periodic::Unattended-Upgrade "1";'    >> /etc/apt/apt.conf.d/20auto-upgrades

# --- SSH hardening ---
cat > /etc/ssh/sshd_config.d/99-lab-hardening.conf <<'EOF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
AllowTcpForwarding yes
EOF
systemctl restart ssh
systemctl enable --now fail2ban

# --- Remove unneeded listeners: rpcbind (NFS helper, :111 on all interfaces) ---
systemctl stop rpcbind.socket rpcbind.service || true
systemctl mask rpcbind.socket rpcbind.service

# --- WireGuard ---
IFACE=$(ip route show default | awk '{print $5; exit}')
# Keys are created in a subshell so the strict umask does not leak into the
# rest of the script (that bug made later files root-only in v1).
(
  umask 077
  mkdir -p /etc/wireguard
  [ -f /etc/wireguard/server.key ] || wg genkey | tee /etc/wireguard/server.key | wg pubkey > /etc/wireguard/server.pub
)
chmod 644 /etc/wireguard/server.pub
SERVER_KEY=$(cat /etc/wireguard/server.key)

echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-wireguard.conf
sysctl --system

# Oracle's Ubuntu image ships iptables REJECT rules for INPUT and FORWARD,
# so we insert our ACCEPT rules above them when wg0 comes up.
# WireGuard itself is only reached locally (via wstunnel); the NSG blocks UDP from the internet.
(umask 077; cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address = 10.66.66.1/24
ListenPort = ${wg_port}
PrivateKey = $${SERVER_KEY}
PostUp   = iptables -I INPUT -p udp --dport ${wg_port} -j ACCEPT; iptables -I FORWARD -i wg0 -j ACCEPT; iptables -I FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -A POSTROUTING -s 10.66.66.0/24 -o $${IFACE} -j MASQUERADE
PostDown = iptables -D INPUT -p udp --dport ${wg_port} -j ACCEPT; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -s 10.66.66.0/24 -o $${IFACE} -j MASQUERADE

[Peer]
# laptop / phone
PublicKey  = ${client_pubkey}
AllowedIPs = 10.66.66.2/32
EOF
)
systemctl enable --now wg-quick@wg0

%{ if wstunnel_prefix != "" ~}
# --- wstunnel: WireGuard over TLS/TCP ${tunnel_port} (for networks that block UDP) ---
(umask 077; mkdir -p /etc/wstunnel; echo "WSTUNNEL_PREFIX=${wstunnel_prefix}" > /etc/wstunnel/env)
WORK=$(mktemp -d)
cd "$${WORK}"
TARBALL="wstunnel_${wstunnel_version}_linux_amd64.tar.gz"
BASE="https://github.com/erebe/wstunnel/releases/download/v${wstunnel_version}"
retry curl -fsSLO "$${BASE}/$${TARBALL}"
retry curl -fsSLO "$${BASE}/checksums.txt"
grep " $${TARBALL}\$" checksums.txt | sha256sum -c -
tar -xzf "$${TARBALL}" wstunnel
install -m 0755 wstunnel /usr/local/bin/wstunnel
cd / && rm -rf "$${WORK}"
id wstunnel >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin wstunnel

cat > /etc/systemd/system/wstunnel.service <<'UNIT'
[Unit]
Description=wstunnel server (WireGuard over TLS/TCP)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
User=wstunnel
Group=wstunnel
EnvironmentFile=/etc/wstunnel/env
ExecStart=/usr/local/bin/wstunnel server --restrict-to 127.0.0.1:${wg_port} --restrict-http-upgrade-path-prefix $${WSTUNNEL_PREFIX} wss://0.0.0.0:${tunnel_port}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

RULE="-p tcp -m state --state NEW -m tcp --dport ${tunnel_port} -j ACCEPT"
iptables -C INPUT $${RULE} 2>/dev/null || iptables -I INPUT 1 $${RULE}
if [ -f /etc/iptables/rules.v4 ] && ! grep -q -- "--dport ${tunnel_port} -j ACCEPT" /etc/iptables/rules.v4; then
  sed -i "/--dport 22 -j ACCEPT/a -A INPUT $${RULE}" /etc/iptables/rules.v4
fi
systemctl daemon-reload
systemctl enable --now wstunnel
%{ endif ~}

echo "BOOTSTRAP DONE" > /var/log/lab-bootstrap.done
chmod 644 /var/log/lab-bootstrap.done
